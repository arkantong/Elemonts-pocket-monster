    "@capacitor/share": "^8.0.3",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "express": "^5.3.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
